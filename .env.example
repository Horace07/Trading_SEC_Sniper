# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Alpaca ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# --- SEC EDGAR ---
# SEC requires a real contact string in the User-Agent header, e.g.:
# "MyFirm contact@myfirm.com"
SEC_USER_AGENT=
SEC_POLL_INTERVAL_SECONDS=0.5

# --- PostgreSQL / TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sniper
POSTGRES_PASSWORD=sniper
POSTGRES_DB=trading_sec_sniper

# --- Risk management ---
MAX_SPREAD_PCT=1.5
MIN_BOOK_VOLUME=100
MAX_POSITION_NOTIONAL_USD=5000
STOP_LOSS_PCT=3.0
TAKE_PROFIT_PCT=5.0
TRAILING_STOP_PCT=2.0
GOLDEN_HOUR_MINUTES=60
